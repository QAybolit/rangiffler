{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(bash localenv.sh)",
      "Bash(bash ports.sh)",
      "Bash(./scripts/wait-for-stand.sh*)",
      "Bash(scripts/wait-for-stand.sh*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker start rfr-mysql)",
      "Bash(docker stop rfr-mysql)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(mv * *.bak)",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(git -C * push*)",
      "Bash(git --git-dir* push*)",
      "Bash(git -c * push*)",
      "Bash(git send-pack*)",
      "Bash(git remote set-url*)",
      "Bash(git remote add*)",
      "Bash(git config * alias*)",
      "Bash(git clean*)",
      "Bash(git rm*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo sync*)",
      "Bash(gh api*)",
      "Bash(/bin/rm*)",
      "Bash(\\rm*)",
      "Bash(command rm*)",
      "Bash(unlink*)",
      "Bash(rmdir*)",
      "Bash(shred*)",
      "Bash(truncate*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(rsync * --delete*)",
      "Bash(rsync * --remove-source-files*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(zsh -c *)",
      "Bash(eval *)",
      "Bash(env *)",
      "Bash(xargs *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(node -e *)",
      "Bash(perl -e *)",
      "Bash(ruby -e *)",
      "Edit(.claude/settings*.json)",
      "Write(.claude/settings*.json)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compile-java.sh",
            "timeout": 180,
            "statusMessage": "Compiling Java..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compile-frontend.sh",
            "timeout": 120,
            "statusMessage": "Type-checking frontend..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-change.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
